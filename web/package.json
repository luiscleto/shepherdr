{
  "name": "shepherdr-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node --max-old-space-size=512 scripts/build.mjs",
    "test": "node --max-old-space-size=512 --import tsx --test src/*.test.ts",
    "test:home": "node --max-old-space-size=512 --import tsx --test src/browser-state.test.ts src/home-actions.test.ts src/home-connection.test.ts src/home-model.test.ts src/home-parser.test.ts src/workspace-actions.test.ts",
    "typecheck": "node --max-old-space-size=512 node_modules/typescript/bin/tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.25.9",
    "happy-dom": "20.11.2",
    "tsx": "4.23.12",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@wterm/dom": "0.3.4",
    "@wterm/ghostty": "0.3.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  }
}
